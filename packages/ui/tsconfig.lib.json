/* Library sources of @cadenway/ui: the development build and the type check. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/ui/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    /* The entry points of this package import each other by name (`@cadenway/ui/core`). The build
       (ng-packagr) resolves them itself; the type check, the tests and Storybook use these paths. */
    "paths": { "@cadenway/ui/*": ["./*/public-api.ts"] }
  },
  "include": ["src/**/*.ts", "*/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.stories.ts", "node_modules", "dist"]
}
