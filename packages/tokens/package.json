{
  "name": "@cadenway/tokens",
  "version": "0.1.1",
  "description": "Cadenway design tokens: CSS variables in light and dark, and the Tailwind 4 theme that maps them.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
