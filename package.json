{
  "name": "cadenway-design-system",
  "version": "0.0.0",
  "description": "Cadenway design system: tokens, icons, Angular bricks and their Storybook.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "storybook": "pnpm --filter @cadenway/storybook run storybook",
    "storybook:build": "pnpm --filter @cadenway/storybook run storybook:build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "ngc --noEmit -p packages/icons/tsconfig.lib.json && ngc --noEmit -p packages/icons/tsconfig.spec.json && ngc --noEmit -p packages/ui/tsconfig.lib.json && ngc --noEmit -p packages/ui/tsconfig.spec.json && ngc --noEmit -p apps/storybook/tsconfig.json",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "test:architecture": "node --test tests/architecture/libraries.spec.mjs",
    "test:storybook": "pnpm --filter @cadenway/storybook run test:storybook",
    "build": "ng build icons && ng build ui",
    "changeset": "changeset",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm storybook:build && pnpm test:storybook && pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@angular/aria": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cdk": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@ng-icons/core": "catalog:",
    "@ng-icons/flag-icons": "catalog:",
    "@ng-icons/phosphor-icons": "catalog:",
    "@ng-icons/svgl": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^30.0.0",
    "marked": "catalog:",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.9.10",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2",
    "vitest": "catalog:"
  }
}
